+def _rms_envelope(data, frame_length, hop_length):
+    """Compute a centered RMS envelope without librosa's large sliding window."""
+    frame_length = max(1, int(frame_length))
+    hop_length = max(1, int(hop_length))
+    source = np.asarray(data, dtype=np.float32)
+    pad = frame_length // 2
+    padded = np.pad(source, (pad, pad), mode="constant")
+    squared = np.square(padded, dtype=np.float64)
+    cumulative = np.concatenate(([0.0], np.cumsum(squared)))
+    starts = np.arange(0, len(source), hop_length, dtype=np.int64)
+    ends = np.minimum(starts + frame_length, len(padded))
+    sums = cumulative[ends] - cumulative[starts]
+    return np.sqrt(np.maximum(sums / frame_length, 1e-12)).astype(np.float32)
